# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# External APIs
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Open-Meteo Free Tier Daily Budget Limits
OPEN_METEO_WARN_LIMIT=8000
OPEN_METEO_BLOCK_LIMIT=9500

# Cache TTLs (in seconds)
CACHE_GEOCODING_TTL=86400
CACHE_WEATHER_TTL=600
CACHE_FORECAST_TTL=1800
CACHE_AIR_QUALITY_TTL=1800
CACHE_CURRENCY_RATES_TTL=3600
CACHE_CURRENCY_LIST_TTL=86400
